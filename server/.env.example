# Copy to .env on the server. Never commit real credentials.
HOST=0.0.0.0
PORT=8080
DATA_DIR=/data
# Use a long random value; keep private even though sessions are opaque.
SESSION_PEPPER=replace-with-a-long-random-secret
# Set to the exact public origin when a browser client is added.
CORS_ORIGIN=https://notes.mandocloud.uk
