# Copy to .env on the server. Never commit real credentials.
HOST=0.0.0.0
PORT=8080
DATA_DIR=/data
# Generate a random secret with at least 32 characters.
SESSION_PEPPER=replace-with-a-long-random-secret
# Comma-separated exact browser origins, if a web client is added.
CORS_ORIGIN=https://notes.mandocloud.uk
